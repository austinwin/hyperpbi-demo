{
  "version": "1.0",
  "bindings": {
    "map": {}
  },
  "interactions": {
    "crossFilter": true,
    "multiSelect": true,
    "externalMode": "auto"
  },
  "renderer": {
    "showHeader": false,
    "showRowCount": false,
    "showStudioButton": true
  },
  "security": {
    "cssMode": "trusted",
    "htmlMode": "trusted",
    "showSanitizerWarnings": false
  },
  "providers": {
    "mode": "maps",
    "basemap": {
      "provider": "osm",
      "enabled": true,
      "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors",
      "maxZoom": 19
    },
    "geocoder": {
      "provider": "none",
      "enabled": false,
      "autocomplete": false,
      "userTriggeredOnly": true,
      "cache": true,
      "minScore": 80,
      "rateLimitPerSecond": 1,
      "resultLimit": 1
    },
    "privacyAcknowledged": false
  },
  "fields": {
    "aliases": {}
  },
  "motion": {
    "enabled": true,
    "reducedMotion": "respect-system",
    "maxConcurrentAnimations": 12
  }
}